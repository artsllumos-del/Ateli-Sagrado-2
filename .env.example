# Ateliê Sagrado - Full Stack ERP Environment Configuration
# Copie este arquivo para .env no desenvolvimento local: cp .env.example .env

# Porta do Servidor (Padrão: 3000)
PORT=3000

# Ambiente de Execução ('development' para Vite HMR/middleware ou 'production' para build estático)
NODE_ENV=development

# Gemini OCR & IA Multimodal (Google AI Studio - opcional para leitura de cupons/notas)
GEMINI_API_KEY=

# Segredos de Criptografia & Tokens (Altere em ambiente de produção!)
JWT_SECRET=atelie-sagrado-super-secret-key-2026
ENCRYPTION_KEY=ateliesagradosecuritykey2026_32
